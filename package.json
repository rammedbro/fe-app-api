{
  "name": "fe-app-api",
  "version": "0.0.0",
  "description": "Web api service written with typescript, express and openapi",
  "main": "./build/index.js",
  "scripts": {
    "dev": "pnpm tsoa spec-and-routes && tsx ./src/index.ts",
    "dev:watch": "nodemon",
    "build": "pnpm clean && pnpm build:routes && pnpm build:spec && pnpm build:app",
    "build:app": "tsc && tsc-alias",
    "build:routes": "pnpm tsoa routes",
    "build:spec": "pnpm tsoa spec",
    "start": "node ./build",
    "clean": "rimraf ./build",
    "tsoa": "node scripts/tsoa.js"
  },
  "keywords": [
    "express",
    "openapi",
    "swagger",
    "typescript"
  ],
  "author": "https://github.com/rammedbro",
  "license": "ISC",
  "dependencies": {
    "@xata.io/client": "^0.30.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "swagger-ui-express": "^5.0.1",
    "tsoa": "^6.4.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.11",
    "@types/swagger-ui-express": "^4.1.7",
    "nodemon": "^3.1.4",
    "rimraf": "^6.0.1",
    "tsc-alias": "^1.8.10",
    "tsx": "^4.19.2",
    "typescript": "^5.5.3"
  }
}
