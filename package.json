{
  "private": true,
  "name": "fe-app-api",
  "version": "1.9.0",
  "license": "SEE LICENSE IN LICENSE.txt",
  "description": "The backend of the fe-app showcase project, a car rental service, built with typescript, express and openapi",
  "keywords": [
    "node",
    "typescript",
    "express",
    "openapi",
    "swagger",
    "tsoa",
    "postgres",
    "prisma",
    "redis"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/rammedbro/fe-app-api.git"
  },
  "author": {
    "name": "Ramil Sharipov",
    "email": "rammedbro@yandex.ru",
    "url": "https://github.com/rammedbro"
  },
  "engines": {
    "node": ">=16"
  },
  "packageManager": "pnpm@8.15.6",
  "type": "commonjs",
  "main": "./build/index.js",
  "scripts": {
    "postinstall": "run-p build:prisma build:routes build:spec",
    "prepare": "husky",
    "dev": "dotenvx run -- tsx ./src/index.ts",
    "dev:watch": "nodemon",
    "build": "run-s clean build:prisma build:packages build:routes build:spec build:app",
    "build:app": "tsc && tsc-alias",
    "build:routes": "pnpm tsoa routes",
    "build:spec": "pnpm tsoa spec",
    "build:prisma": "prisma generate --generator client --generator json",
    "build:models": "prisma generate --generator models",
    "build:packages": "pnpm run -r build",
    "start": "node ./build/index.js",
    "lint": "run-p lint:*",
    "lint:js": "eslint \"**/*.{js,mjs,ts}\"",
    "lint:types": "tsc --noEmit",
    "db:gui": "prisma studio",
    "release": "semantic-release",
    "clean": "rimraf build",
    "clean:modules": "rimraf -g ./**/node_modules",
    "tsoa": "tsx ./scripts/tsoa.ts"
  },
  "prisma": {
    "seed": "tsx ./scripts/prisma.ts seed"
  },
  "dependencies": {
    "@prisma/adapter-pg": "6.2.1",
    "@prisma/client": "6.2.1",
    "argon2": "^0.41.1",
    "connect-redis": "^8.0.1",
    "cors": "^2.8.5",
    "debug": "^4.4.0",
    "decimal.js": "^10.5.0",
    "error-tracking": "workspace:^",
    "express": "^4.21.2",
    "express-session": "^1.18.1",
    "http-errors": "^2.0.0",
    "owasp-password-strength-test": "^1.3.0",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0",
    "pg": "^8.13.3",
    "redis": "^4.7.0",
    "swagger-ui-express": "^5.0.1",
    "telemetry": "workspace:^",
    "tsoa": "^6.6.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.0",
    "@commitlint/types": "^19.5.0",
    "@dotenvx/dotenvx": "^1.33.0",
    "@eslint/js": "^9.18.0",
    "@faker-js/faker": "^9.4.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/gitlab": "^13.2.4",
    "@sentry/cli": "^2.43.1",
    "@types/cors": "^2.8.17",
    "@types/debug": "^4.1.12",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.18.1",
    "@types/node": "^20.14.11",
    "@types/owasp-password-strength-test": "^1.3.2",
    "@types/passport": "^1.0.17",
    "@types/passport-local": "^1.0.38",
    "@types/pg": "^8.11.11",
    "@types/swagger-ui-express": "^4.1.7",
    "conventional-changelog-conventionalcommits": "^7.0.2",
    "eslint": "^9.18.0",
    "eslint-import-resolver-typescript": "^3.7.0",
    "eslint-plugin-import-x": "^4.6.1",
    "eslint-plugin-n": "^17.15.1",
    "husky": "^9.1.7",
    "lint-staged": "^15.4.1",
    "nodemon": "^3.1.4",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.4.2",
    "prettier-plugin-organize-imports": "^4.1.0",
    "prisma": "6.2.1",
    "prisma-generator-typescript-interfaces": "^1.7.0",
    "prisma-json-types-generator": "^3.2.2",
    "rimraf": "^6.0.1",
    "semantic-release": "^22.0.12",
    "semantic-release-jira-notes": "^4.0.0",
    "tsc-alias": "^1.8.10",
    "tsup": "^8.4.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.21.0"
  }
}
