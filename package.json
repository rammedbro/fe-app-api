{
  "name": "fe-app-api",
  "version": "0.0.0",
  "description": "Web api service written with typescript, express and openapi",
  "engines": {
    "node": ">=16"
  },
  "packageManager": "pnpm@8.15.6",
  "type": "commonjs",
  "main": "./build/index.js",
  "scripts": {
    "dev": "pnpm tsoa spec-and-routes && dotenvx run -f .env.development -- tsx ./src/index.ts",
    "dev:watch": "nodemon",
    "build": "run-s clean build:prisma build:routes build:spec build:app",
    "build:app": "tsc && tsc-alias",
    "build:routes": "pnpm tsoa routes",
    "build:spec": "pnpm tsoa spec",
    "build:prisma": "prisma generate",
    "start": "node ./build",
    "clean": "rimraf ./build",
    "tsoa": "tsx ./scripts/tsoa.ts",
    "lint:js": "eslint \"**/*.{js,mjs,ts}\"",
    "lint:types": "tsc --noEmit",
    "prepare": "husky"
  },
  "prisma": {
    "seed": "tsx ./scripts/prisma.ts seed"
  },
  "keywords": [
    "typescript",
    "express",
    "openapi",
    "swagger",
    "postgres",
    "prisma"
  ],
  "author": "https://github.com/rammedbro",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "6.2.1",
    "express": "^4.19.2",
    "swagger-ui-express": "^5.0.1",
    "tsoa": "^6.6.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.0",
    "@commitlint/types": "^19.5.0",
    "@dotenvx/dotenvx": "^1.33.0",
    "@eslint/js": "^9.18.0",
    "@faker-js/faker": "^9.4.0",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.11",
    "@types/swagger-ui-express": "^4.1.7",
    "@typescript-eslint/parser": "^8.21.0",
    "eslint": "^9.18.0",
    "eslint-import-resolver-typescript": "^3.7.0",
    "eslint-plugin-import-x": "^4.6.1",
    "eslint-plugin-n": "^17.15.1",
    "husky": "^9.1.7",
    "lint-staged": "^15.4.1",
    "nodemon": "^3.1.4",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.4.2",
    "prisma": "6.2.1",
    "prisma-generator-typescript-interfaces": "^1.7.0",
    "rimraf": "^6.0.1",
    "tsc-alias": "^1.8.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.21.0"
  }
}
