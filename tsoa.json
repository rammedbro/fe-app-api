{
  "$schema": "https://json.schemastore.org/tsoa.json",
  "entryFile": "./src/index.ts",
  "noImplicitAdditionalProperties": "throw-on-extras",
  "controllerPathGlobs": ["./src/controllers/**/controller.ts"],
  "defaultNumberType": "integer",
  "routes": {
    "routesDir": "./src/app/providers/router",
    "routesFileName": "routes.ts",
    "bodyCoercion": false,
    "authenticationModule": "./src/app/providers/auth.ts"
  },
  "spec": {
    "outputDirectory": "./build",
    "specVersion": 3,
    "basePath": "/api",
    "securityDefinitions": {
      "cookie": {
        "type": "apiKey",
        "in": "header",
        "name": "sid",
        "description": "A 'sid' key in Cookie header string of an authenticated user"
      }
    }
  }
}
